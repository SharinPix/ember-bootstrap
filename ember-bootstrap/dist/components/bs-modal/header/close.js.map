import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<button type=\"button\" aria-label=\"Close\" class={{if (macroCondition (macroGetOwnConfig \"isBS5\")) \"btn-close\" \"close\"}} ...attributes {{on \"click\" (bs-default @onClick (bs-noop))}}>\n  {{#if (macroCondition (macroGetOwnConfig \"isBS4\"))}}<span aria-hidden=\"true\">&times;</span>{{/if}}\n</button>")