import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("{{! @glint-nocheck }}\n<BsLinkTo\n  @route={{@route}}\n  @model={{@model}}\n  @models={{@models}}\n  @query={{@query}}\n  @disabled={{@disabled}}\n  {{on \'click\' this.onClick}}\n  class={{@attrClassInternal}}\n  ...attributes\n>\n  {{yield}}\n</BsLinkTo>")