import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<div\n  class=\"accordion\"\n  ...attributes\n>\n  {{yield\n    (hash\n      item=(component (ensure-safe-component this.itemComponent) selected=this.isSelected onClick=this.doChange)\n      change=this.doChange\n    )\n  }}\n</div>\n")