import { precompileTemplate } from "@ember/template-compilation";
export default precompileTemplate("<BsCollapse @collapsed={{@collapsed}} class=\"accordion-collapse\" id={{@collapsableId}} aria-describedby={{@describedby}}>\n  <div class=\"{{if (macroCondition (macroGetOwnConfig \"isBS4\")) \"card-body\"}} {{if (macroCondition (macroGetOwnConfig \"isBS5\")) \"accordion-body\"}}\">\n    {{yield}}\n  </div>\n</BsCollapse>")