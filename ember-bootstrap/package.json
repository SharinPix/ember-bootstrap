{
  "name": "ember-bootstrap",
  "version": "6.6.1",
  "description": "Bootstrap components for Ember.js",
  "keywords": [
    "ember-addon",
    "bootstrap"
  ],
  "homepage": "https://www.ember-bootstrap.com/",
  "bugs": {
    "url": "https://github.com/ember-bootstrap/ember-bootstrap/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-bootstrap/ember-bootstrap"
  },
  "license": "MIT",
  "author": "Simon Ihmig <ihmig@kaliber5.de>",
  "exports": {
    ".": "./dist/index.js",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./components/*": {
      "types": "./declarations/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./helpers/*": {
      "types": "./declarations/helpers/*.d.ts",
      "default": "./dist/helpers/*.js"
    },
    "./modifiers/*": {
      "types": "./declarations/modifiers/*.d.ts",
      "default": "./dist/modifiers/*.js"
    },
    "./utils/*": {
      "types": "./declarations/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./initializers/*": {
      "types": "./declarations/initializers/*.d.ts",
      "default": "./dist/initializers/*.js"
    },
    "./addon-main.cjs": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*",
        "declarations/*/index.d.ts"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "declarations"
  ],
  "scripts": {
    "build": "concurrently \"npm:build:*\" --names \"build:\"",
    "build:js": "rollup --config",
    "build:types": "glint --declaration",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "glint",
    "prepublishOnly": "concurrently \"npm:build:*\" --names \"build:\"",
    "start": "rollup --config --watch",
    "release": "pnpm exec release-it"
  },
  "dependencies": {
    "@ember/render-modifiers": "^3.0.0",
    "@embroider/addon-shim": "^1.8.9",
    "@embroider/macros": "^1.0.0",
    "ember-concurrency": "^4.0.0",
    "ember-element-helper": "^0.8.0",
    "ember-focus-trap": "^1.0.0",
    "ember-on-helper": "^0.1.0",
    "ember-popper-modifier": "^4.0.0",
    "ember-ref-bucket": "^5.0.0",
    "ember-render-helpers": "^2.0.0",
    "ember-style-modifier": "^4.0.0",
    "tracked-toolbox": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/plugin-transform-class-properties": "^7.24.0",
    "@babel/plugin-transform-typescript": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@embroider/addon-dev": "^8.0.0",
    "@glint/core": "1.5.2",
    "@glint/environment-ember-loose": "1.5.2",
    "@glint/template": "1.7.3",
    "@popperjs/core": "2.11.8",
    "@release-it-plugins/lerna-changelog": "8.0.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@simple-dom/interface": "1.4.0",
    "@tsconfig/ember": "3.0.12",
    "@types/rsvp": "4.0.9",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-plugin-ember-template-compilation": "^2.3.0",
    "concurrently": "9.2.1",
    "ember-template-lint": "5.13.0",
    "ember-template-lint-plugin-prettier": "5.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "12.7.5",
    "eslint-plugin-hbs": "1.0.3",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-qunit": "8.2.5",
    "focus-trap": "7.6.6",
    "release-it": "19.0.6",
    "rollup": "^4.22.0",
    "rollup-plugin-copy": "^3.5.0",
    "@rollup/plugin-alias": "^5.1.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@glimmer/component": "^1.0.4 || ^2.0.0",
    "@glimmer/tracking": "^1.0.4",
    "ember-modifier": "^3.2.7 || ^4.0.0",
    "ember-source": ">= 5.12.0"
  },
  "engines": {
    "node": "20.* || 22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2,
    "versionCompatibility": {
      "ember": ">=4.8.0"
    },
    "demoURL": "https://www.ember-bootstrap.com",
    "config": {
      "@embroider/macros": {
        "setOwnConfig": {
          "isBS4": false,
          "isBS5": true,
          "isNotBS5": false,
          "version": "6.6.1"
        }
      }
    },
    "app-js": {
      "./components/bs-accordion.js": "./dist/_app_/components/bs-accordion.js",
      "./components/bs-accordion/item.js": "./dist/_app_/components/bs-accordion/item.js",
      "./components/bs-accordion/item/body.js": "./dist/_app_/components/bs-accordion/item/body.js",
      "./components/bs-accordion/item/title.js": "./dist/_app_/components/bs-accordion/item/title.js",
      "./components/bs-alert.js": "./dist/_app_/components/bs-alert.js",
      "./components/bs-button-group.js": "./dist/_app_/components/bs-button-group.js",
      "./components/bs-button-group/button.js": "./dist/_app_/components/bs-button-group/button.js",
      "./components/bs-button.js": "./dist/_app_/components/bs-button.js",
      "./components/bs-carousel.js": "./dist/_app_/components/bs-carousel.js",
      "./components/bs-carousel/slide.js": "./dist/_app_/components/bs-carousel/slide.js",
      "./components/bs-collapse.js": "./dist/_app_/components/bs-collapse.js",
      "./components/bs-contextual-help.js": "./dist/_app_/components/bs-contextual-help.js",
      "./components/bs-contextual-help/element.js": "./dist/_app_/components/bs-contextual-help/element.js",
      "./components/bs-dropdown.js": "./dist/_app_/components/bs-dropdown.js",
      "./components/bs-dropdown/button.js": "./dist/_app_/components/bs-dropdown/button.js",
      "./components/bs-dropdown/menu.js": "./dist/_app_/components/bs-dropdown/menu.js",
      "./components/bs-dropdown/menu/divider.js": "./dist/_app_/components/bs-dropdown/menu/divider.js",
      "./components/bs-dropdown/menu/item.js": "./dist/_app_/components/bs-dropdown/menu/item.js",
      "./components/bs-dropdown/toggle.js": "./dist/_app_/components/bs-dropdown/toggle.js",
      "./components/bs-form.js": "./dist/_app_/components/bs-form.js",
      "./components/bs-form/element.js": "./dist/_app_/components/bs-form/element.js",
      "./components/bs-form/element/control.js": "./dist/_app_/components/bs-form/element/control.js",
      "./components/bs-form/element/control/checkbox.js": "./dist/_app_/components/bs-form/element/control/checkbox.js",
      "./components/bs-form/element/control/input.js": "./dist/_app_/components/bs-form/element/control/input.js",
      "./components/bs-form/element/control/radio.js": "./dist/_app_/components/bs-form/element/control/radio.js",
      "./components/bs-form/element/control/switch.js": "./dist/_app_/components/bs-form/element/control/switch.js",
      "./components/bs-form/element/control/textarea.js": "./dist/_app_/components/bs-form/element/control/textarea.js",
      "./components/bs-form/element/errors.js": "./dist/_app_/components/bs-form/element/errors.js",
      "./components/bs-form/element/feedback-icon.js": "./dist/_app_/components/bs-form/element/feedback-icon.js",
      "./components/bs-form/element/help-text.js": "./dist/_app_/components/bs-form/element/help-text.js",
      "./components/bs-form/element/label.js": "./dist/_app_/components/bs-form/element/label.js",
      "./components/bs-form/element/layout/horizontal.js": "./dist/_app_/components/bs-form/element/layout/horizontal.js",
      "./components/bs-form/element/layout/horizontal/checkbox.js": "./dist/_app_/components/bs-form/element/layout/horizontal/checkbox.js",
      "./components/bs-form/element/layout/inline.js": "./dist/_app_/components/bs-form/element/layout/inline.js",
      "./components/bs-form/element/layout/inline/checkbox.js": "./dist/_app_/components/bs-form/element/layout/inline/checkbox.js",
      "./components/bs-form/element/layout/vertical.js": "./dist/_app_/components/bs-form/element/layout/vertical.js",
      "./components/bs-form/element/layout/vertical/checkbox.js": "./dist/_app_/components/bs-form/element/layout/vertical/checkbox.js",
      "./components/bs-form/element/legend.js": "./dist/_app_/components/bs-form/element/legend.js",
      "./components/bs-link-to.js": "./dist/_app_/components/bs-link-to.js",
      "./components/bs-list-group.js": "./dist/_app_/components/bs-list-group.js",
      "./components/bs-list-group/item.js": "./dist/_app_/components/bs-list-group/item.js",
      "./components/bs-modal-simple.js": "./dist/_app_/components/bs-modal-simple.js",
      "./components/bs-modal.js": "./dist/_app_/components/bs-modal.js",
      "./components/bs-modal/body.js": "./dist/_app_/components/bs-modal/body.js",
      "./components/bs-modal/dialog.js": "./dist/_app_/components/bs-modal/dialog.js",
      "./components/bs-modal/footer.js": "./dist/_app_/components/bs-modal/footer.js",
      "./components/bs-modal/header.js": "./dist/_app_/components/bs-modal/header.js",
      "./components/bs-modal/header/close.js": "./dist/_app_/components/bs-modal/header/close.js",
      "./components/bs-modal/header/title.js": "./dist/_app_/components/bs-modal/header/title.js",
      "./components/bs-nav.js": "./dist/_app_/components/bs-nav.js",
      "./components/bs-nav/item.js": "./dist/_app_/components/bs-nav/item.js",
      "./components/bs-navbar.js": "./dist/_app_/components/bs-navbar.js",
      "./components/bs-navbar/content.js": "./dist/_app_/components/bs-navbar/content.js",
      "./components/bs-navbar/link-to.js": "./dist/_app_/components/bs-navbar/link-to.js",
      "./components/bs-navbar/nav.js": "./dist/_app_/components/bs-navbar/nav.js",
      "./components/bs-navbar/toggle.js": "./dist/_app_/components/bs-navbar/toggle.js",
      "./components/bs-popover.js": "./dist/_app_/components/bs-popover.js",
      "./components/bs-popover/element.js": "./dist/_app_/components/bs-popover/element.js",
      "./components/bs-progress.js": "./dist/_app_/components/bs-progress.js",
      "./components/bs-progress/bar.js": "./dist/_app_/components/bs-progress/bar.js",
      "./components/bs-spinner.js": "./dist/_app_/components/bs-spinner.js",
      "./components/bs-tab.js": "./dist/_app_/components/bs-tab.js",
      "./components/bs-tab/pane.js": "./dist/_app_/components/bs-tab/pane.js",
      "./components/bs-tooltip.js": "./dist/_app_/components/bs-tooltip.js",
      "./components/bs-tooltip/element.js": "./dist/_app_/components/bs-tooltip/element.js",
      "./helpers/bs-contains.js": "./dist/_app_/helpers/bs-contains.js",
      "./helpers/bs-default.js": "./dist/_app_/helpers/bs-default.js",
      "./helpers/bs-eq.js": "./dist/_app_/helpers/bs-eq.js",
      "./helpers/bs-form-horiz-input-class.js": "./dist/_app_/helpers/bs-form-horiz-input-class.js",
      "./helpers/bs-form-horiz-offset-class.js": "./dist/_app_/helpers/bs-form-horiz-offset-class.js",
      "./helpers/bs-noop.js": "./dist/_app_/helpers/bs-noop.js",
      "./helpers/bs-size-class.js": "./dist/_app_/helpers/bs-size-class.js",
      "./helpers/bs-type-class.js": "./dist/_app_/helpers/bs-type-class.js",
      "./initializers/load-bootstrap-config.js": "./dist/_app_/initializers/load-bootstrap-config.js",
      "./modifiers/bs-conditional-attribute.js": "./dist/_app_/modifiers/bs-conditional-attribute.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "changelog": {
    "labels": {
      "breaking": ":boom: Breaking Change",
      "enhancement": "Features",
      "bug": "Bug Fixes",
      "documentation": "Documentation",
      "internal": "Internal"
    }
  },
  "release-it": {
    "plugins": {
      "@release-it-plugins/lerna-changelog": {
        "infile": "./CHANGELOG.md",
        "launchEditor": true
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    }
  },
  "volta": {
    "extends": "../package.json"
  }
}
